{
  "color": {
    "light": {
      "background":     { "$type": "color", "$value": "#F8F6F1" },
      "surface":        { "$type": "color", "$value": "#FFFFFF" },
      "field":          { "$type": "color", "$value": "#EFECE5" },
      "hairline":       { "$type": "color", "$value": "#E6E1D7" },
      "text-primary":   { "$type": "color", "$value": "#1D1B18" },
      "text-secondary": { "$type": "color", "$value": "#6B645A" },
      "text-refrain":   { "$type": "color", "$value": "#3E3932" },
      "icon-faint":     { "$type": "color", "$value": "#B3ACA1" },
      "switch-off":     { "$type": "color", "$value": "#D9D4CA" },
      "accent":         { "$type": "color", "$value": "#34479A" },
      "on-accent":      { "$type": "color", "$value": "#FFFFFF" }
    },
    "dark": {
      "background":     { "$type": "color", "$value": "#141312" },
      "surface":        { "$type": "color", "$value": "#1D1C1A" },
      "field":          { "$type": "color", "$value": "#242320" },
      "hairline":       { "$type": "color", "$value": "#2C2A27" },
      "text-primary":   { "$type": "color", "$value": "#ECE8E1" },
      "text-secondary": { "$type": "color", "$value": "#A39C92" },
      "text-refrain":   { "$type": "color", "$value": "#CFC9C0" },
      "icon-faint":     { "$type": "color", "$value": "#5E5952" },
      "switch-off":     { "$type": "color", "$value": "#3A3834" },
      "accent":         { "$type": "color", "$value": "#9DAAF0" },
      "on-accent":      { "$type": "color", "$value": "#141312" }
    }
  },
  "font": {
    "family": {
      "serif": { "$type": "fontFamily", "$value": "Source Serif 4" },
      "sans":  { "$type": "fontFamily", "$value": "Inter" }
    }
  },
  "typography": {
    "song-title":   { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontSize": "30px", "lineHeight": "36px", "fontWeight": 500, "letterSpacing": "-0.01em" } },
    "lyrics":       { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontSize": "20px", "lineHeight": "32px", "fontWeight": 400 } },
    "refrain":      { "$type": "typography", "$value": { "fontFamily": "{font.family.serif}", "fontSize": "20px", "lineHeight": "32px", "fontWeight": 400, "fontStyle": "italic" } },
    "screen-title": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "32px", "lineHeight": "38px", "fontWeight": 600, "letterSpacing": "-0.02em" } },
    "section":      { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "lineHeight": "22px", "fontWeight": 600 } },
    "row":          { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "22px", "fontWeight": 400 } },
    "meta":         { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 } },
    "overline":     { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "14px", "fontWeight": 500, "letterSpacing": "0.08em", "textCase": "uppercase" } },
    "tab-label":    { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "14px", "fontWeight": 500 } }
  },
  "space": {
    "4":  { "$type": "dimension", "$value": "4px" },
    "8":  { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "28": { "$type": "dimension", "$value": "28px" },
    "48": { "$type": "dimension", "$value": "48px" },
    "screen-margin": { "$type": "dimension", "$value": "20px" },
    "touch-target":  { "$type": "dimension", "$value": "44px" }
  },
  "radius": {
    "field": { "$type": "dimension", "$value": "12px" },
    "tile":  { "$type": "dimension", "$value": "10px" },
    "card":  { "$type": "dimension", "$value": "14px" },
    "sheet": { "$type": "dimension", "$value": "20px" },
    "pill":  { "$type": "dimension", "$value": "999px" }
  }
}
